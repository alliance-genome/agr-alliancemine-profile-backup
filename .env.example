# Copy to .env.local (git-ignored) and fill in. Sourced after config/backup_config.env.

# S3 copy for the file backend (optional)
# export S3_BUCKET="your-bucket"
# export S3_PREFIX="postgres"
# export KEEP_LOCAL_BACKUPS="true"

# restic backend (BACKUP_BACKEND=restic)
# export BACKUP_BACKEND="restic"
# export RESTIC_REPOSITORY="s3:s3.amazonaws.com/your-bucket/postgres-restic"
# export RESTIC_PASSWORD_FILE="/path/to/restic-password"   # chmod 600, never commit
# export AWS_ACCESS_KEY_ID="..."        # or use an instance profile / AWS_PROFILE
# export AWS_SECRET_ACCESS_KEY="..."
# export RESTIC_VERIFY_DUMP="true"      # pg_restore --list the new snapshot
# export RESTIC_PRUNE="true"            # run restic prune after forget
