# Copy to .env.local (git-ignored) and fill in. Sourced after config/backup_config.env.

# S3 (optional)
# export S3_BUCKET="your-bucket"
# export S3_PREFIX="postgres"
# export KEEP_LOCAL_BACKUPS="true"

# Notifications via Apprise (optional). Space-separated URLs; see
# https://github.com/caronc/apprise/wiki for the URL format of each service.
# export APPRISE_URLS="slack://TokenA/TokenB/TokenC/#channel mailto://user:password@smtp.example.com?to=ops@example.com"
# export APPRISE_CONFIG="/path/to/apprise.yml"
